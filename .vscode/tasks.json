{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build_cpp",
			"type": "shell",
			"command": "bash",
			"args": [
				{
					// Windows ではパス変数が \ 区切りで展開されるので、bash に消されないよう強い引用で渡す
					"value": "${workspaceFolder}/scripts/build_cpp.bash",
					"quoting": "strong"
				}
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
