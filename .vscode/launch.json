	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/build/foo.exe",
			"args": [],
			"stdio": [
				"${workspaceFolder}/work/input.txt",
				null,
				null
			],
			"cwd": "${workspaceFolder}",
			// それはそれでCodeLLDBの不具合を踏むので、やはりデフォルトプロファイル先をcmdで動くスクリプトにし、そこで確実にMSYSのシェルを呼ぶ羽目に...
			// // 統合ターミナルを使うと、VS Code がプロファイルの env を渡さず MSYS 環境のシェルが残るので、デバッグコンソールに出す
			// "terminal": "console",
		}
	]
}
